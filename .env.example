# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value here is the DEFAULT the code uses,
# so a verbatim copy produces a working system.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Used during ingestion for the cloud embedding lane (text-embedding-3-small).
OPENAI_API_KEY=sk-your-key-here

# --- Qdrant -----------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Must match what ingestion writes to. One name, everywhere.
QDRANT_COLLECTION=financial_reports

# --- LLM (Ollama) -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3
# 0.1, not 0.7: financial Q&A is extraction, not composition. A model that
# paraphrases a figure has produced a defect, not a variation.
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=2048

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Chunks scoring below this are discarded rather than padding the context
# with near-misses. Tune against the eval set, not by feel.
RETRIEVAL_SCORE_THRESHOLD=0.3

# --- Agent ------------------------------------------------------------------
MAX_ITERATIONS=5

# --- Optional ---------------------------------------------------------------
# Web search lane. Leave unset to disable it.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
